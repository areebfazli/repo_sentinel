# GitHub Configuration
# Generate a Personal Access Token (classic) with `repo` scope at https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# OpenRouter Configuration
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Environment Type
# Use "development" to use local/in-memory services (no Docker needed)
# Use "production" to connect to external/Docker services
ENVIRONMENT=development

# Database Settings (Only used if ENVIRONMENT=production)
# For development, an SQLite file will be created automatically
DATABASE_URL=postgresql://user:pass@localhost/repo_sentinel

# Redis Settings (Only used if ENVIRONMENT=production)
# For development, fakeredis will be used automatically
REDIS_URL=redis://localhost:6379

# Qdrant Settings (Only used if ENVIRONMENT=production)
# For development, data will be saved locally to ./qdrant_data
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Models Configuration
CODEBERT_MODEL=microsoft/codebert-base
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SEVERITY_MODEL=distilbert-base-uncased

# MLflow Tracking (Optional)
# MLFLOW_TRACKING_URI=http://localhost:5000
