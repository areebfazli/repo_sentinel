# Environment Type
# "development" -> local/in-memory services (no Docker): file Qdrant + SQLite.
# "production"  -> external services; REPOSENTINEL_API_KEY becomes required.
ENVIRONMENT=development

# Load the embedder + cross-encoder into RAM at boot (first run downloads them).
# false defers loading to the first scan; the test suite sets this.
# PRELOAD_MODELS=true

# GitHub Configuration
# Personal Access Token (classic) with `repo` scope: https://github.com/settings/tokens
# Used by the Team Memory crawler (scripts/ingest_team_history.py --repo owner/name).
GITHUB_TOKEN=your_github_token_here

# API auth — shared secret required on /analyze and /feedback in production.
# Leave blank in development to keep the endpoints open locally.
REPOSENTINEL_API_KEY=

# Browser origins allowed to call the API (where the static dashboard is served
# from). JSON list. Default covers `cd frontend && python -m http.server 8080`.
# CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# Scans running at once in this process; the rest wait as "queued". Each scan
# runs model inference, so keep this small on CPU-only hosts.
# MAX_CONCURRENT_SCANS=2

# LLM Providers (OpenAI-compatible chat-completions endpoints).
# LLM_PROVIDER selects the primary; LLM_FALLBACK_PROVIDER is tried on failure.
# A configured provider with a missing key errors at startup (never a silent mock).
# Set LLM_PROVIDER=mock to run the pipeline without any LLM key.
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
# Same-provider retries on 429/5xx/timeout (with backoff) before falling through
# to LLM_FALLBACK_PROVIDER. 0 disables same-provider retry (immediate fallthrough).
LLM_RETRIES=1
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash
# Per-request timeout for the chat-completions call.
# LLM_TIMEOUT_SECONDS=60

# Models
# Changing EMBEDDING_MODEL requires --recreate on BOTH collections (mixed-model
# vectors silently destroy relevance):
#   python scripts/ingest_cve_corpus.py --recreate
#   python scripts/ingest_team_history.py --recreate
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
EMBEDDING_POOLING=mean
# EMBEDDING_DIM=768                 # vector size written to Qdrant; must match the embedder's output dim
# EMBEDDING_MAX_TOKENS=2048         # max tokens per snippet before truncation
# EMBEDDING_TRUST_REMOTE_CODE=True  # jina-embeddings-v2-base-code needs this for its custom BERT-ALiBi architecture
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_MAX_TOKENS=1024          # BAAI's recommended max pair length for bge-reranker-v2-m3
# RERANKER_BATCH_SIZE=8             # pairs per batch; activation memory scales with pair length

# Retrieval thresholds (calibrated via ml/evaluation; these are the defaults)
# SIM_THRESHOLD_CVE=0.25
# SIM_THRESHOLD_TEAM=0.25
# RERANK_THRESHOLD=0.0
# RETRIEVAL_TOP_K=3
# ANN_CANDIDATES=10

# Feedback loop. Votes are summed per vector across all scans; a memory at/below
# FEEDBACK_SUPPRESS_NET is dropped; otherwise the score is multiplied by
# max(0.3, 1 + FEEDBACK_DOWNWEIGHT_PER_VOTE * net) for net < 0. Upvotes never boost.
# FEEDBACK_SUPPRESS_NET=-2
# FEEDBACK_DOWNWEIGHT_PER_VOTE=0.15

# Team Memory weighting: older review comments decay with this half-life, and
# comments from these GitHub author associations are weighted up. JSON object.
# RECENCY_HALF_LIFE_DAYS=180
# SENIORITY_WEIGHTS={"OWNER":1.2,"MEMBER":1.1,"COLLABORATOR":1.05}

# Files mode: max functions analyzed per scan (extra units are dropped and noted
# in the report).
# MAX_UNITS_PER_SCAN=50

# Hybrid dense+sparse (BM25) retrieval with RRF fusion. Off by default (on the
# eval it matches dense F1 with perfect recall — a modest gain below the adoption
# bar). Enabling it REQUIRES re-ingesting both collections with --recreate.
# HYBRID_ENABLED=false
# HYBRID_SPARSE_MIN_SCORE=10.0

# Database Settings (Only used if ENVIRONMENT=production)
# In development an SQLite file (repo_sentinel.sqlite) is created automatically.
# DATABASE_URL=postgresql://user:pass@localhost/repo_sentinel

# Qdrant Settings (Only used if ENVIRONMENT=production)
# In development, vectors are saved locally to ./qdrant_data
QDRANT_HOST=localhost
QDRANT_PORT=6333
