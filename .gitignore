# Python environments
venv/
env/
.env
__pycache__/
*.pyc
*.pyo

# Qdrant local data
qdrant_data/

# SQLite databases
*.sqlite
*.sqlite3

# Logs
*.log

# IDEs
.vscode/
.idea/

# MLflow tracking
mlruns/

# Local-only agent guidance (kept on disk, not tracked)
CLAUDE.md

# Local-only working report (kept on disk, not tracked)
REPORT.md

# OSV bulk-export + GitHub API response cache for scripts/build_corpus_from_osv.py
data/osv_cache/

# Rejected OSV pairs (audit output of the quality filter; regenerate with --offline)
data/cve_corpus/rejected/

# Eval outputs too big / too volatile to version (the small result summaries
# the ROADMAP cites are committed): the LLM response cache and guard_diff's
# per-pair rows (2.3 MB; regenerate with python -m ml.evaluation.eval_guard_diff).
ml/evaluation/results/llm_cache.jsonl
ml/evaluation/results/guard_diff_eval.json

# PR eval datasets (full file contents, ~180 MB; regenerate offline in ~30 s with
# python scripts/build_pr_eval.py; the committed pr_eval_v1_manifest.json pins their sha256)
ml/evaluation/datasets/pr_eval/*.jsonl
